<!-- Sidebar Navigation -->
<aside class="hidden md:flex flex-col w-64 bg-white dark:bg-[#1a2632] border-r border-slate-200 dark:border-slate-800 flex-shrink-0 z-20">
<div class="flex flex-col justify-between h-full p-4">
<div class="flex flex-col gap-6">
<!-- Logo Area -->
<div class="flex items-center gap-3 px-2">
<div class="aspect-square size-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">local_hospital</span>
</div>
<div class="flex flex-col">
<h1 class="text-slate-900 dark:text-white text-lg font-bold leading-normal">PulseCare</h1>
<p class="text-slate-500 dark:text-slate-400 text-xs font-normal leading-normal">ERP System</p>
</div>
</div>

<!-- Navigation Links - Role-Based -->
<div class="flex flex-col gap-2">
<!-- Admin Links - Only for Admins -->
<% if (typeof user !== 'undefined' && user.role === 'admin') { %>
<a class="group flex items-center gap-3 rounded-lg px-3 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" href="/operations" title="View operations dashboard">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400 group-hover:text-primary">bar_chart</span>
<p class="text-sm font-medium">Operations</p>
</a>

<a class="group flex items-center gap-3 rounded-lg px-3 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" href="/staff" title="Manage staff">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400 group-hover:text-primary">groups</span>
<p class="text-sm font-medium">Staff</p>
</a>
<% } %>

<!-- Doctor Links - Only for Doctors and Admins -->
<% if (typeof user !== 'undefined' && (user.role === 'doctor' || user.role === 'admin')) { %>
<a class="group flex items-center gap-3 rounded-lg px-3 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" href="/patientflow" title="View patient flow">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400 group-hover:text-primary">person</span>
<p class="text-sm font-medium">Patient Flow</p>
</a>
<% } %>

<!-- Patient Dashboard - All authenticated users -->
<% if (typeof user !== 'undefined') { %>
<a class="group flex items-center gap-3 rounded-lg px-3 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" href="/patient" title="View your dashboard">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400 group-hover:text-primary">dashboard</span>
<p class="text-sm font-medium">Dashboard</p>
</a>

<!-- Logout - All authenticated users -->
<a class="group flex items-center gap-3 rounded-lg px-3 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" href="/logout" title="Logout">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400 group-hover:text-primary">logout</span>
<p class="text-sm font-medium">Logout</p>
</a>
<% } %>
</div>
</div>

<!-- User Profile -->
<div class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer transition-colors">
<div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 bg-slate-200" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDUGXxjGtwZ0ZAgO7XFYK2ZXeq1ZMtN1wvAEATl3eHqipEQ72oQuFmSxj1y2_S7A5RtOBo7DSxb0yf1NlcxtWfYCrSHv47pW4HBs-2EhuCODzx6wpbaljD6Fv0MnYDQp6K-4LOqYQLgHN2kpkfiU7uaWBBqAM0X3VwPxE3KigoDYU_nP1C-MTTNtcVvD6vV5az6eEZSJDc-ZRKT_9C9ygYFMsQPe8l7bqdteRt54Q96lU2J2kvoI7g-Lfl4x3yrYAD1wNS4Nt2Q-cY");'></div>
<div class="flex flex-col">
<% if (typeof user !== 'undefined') { %>
<p class="text-sm font-medium text-slate-900 dark:text-white leading-normal"><%= user.name %></p>
<p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-normal capitalize"><%= user.role %></p>
<% } else { %>
<p class="text-sm font-medium text-slate-900 dark:text-white leading-normal">User</p>
<p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-normal">Patient</p>
<% } %>
</div>
</div>
</div>
</aside>
