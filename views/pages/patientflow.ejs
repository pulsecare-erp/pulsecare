<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Patient Flow Dashboard - PulseCare ERP</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#2b8cee",
                        "primary-dark": "#1a6bbd",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                        "surface-light": "#ffffff",
                        "surface-dark": "#1a2632",
                        "text-main": "#0d141b",
                        "text-secondary": "#4c739a",
                        "status-green": "#078838",
                        "status-red": "#e73908",
                        "status-yellow": "#e8aa08",
                        "border-light": "#e7edf3",
                        "border-dark": "#2a3b4d",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-text-main dark:text-gray-100 min-h-screen flex flex-col">
<%- include('../partials/navbar') %>
<div class="flex flex-1 flex-col max-w-[1440px] mx-auto w-full px-4 lg:px-10 pb-10">
<!-- Page Header -->
<div class="flex flex-wrap justify-between items-end gap-4 py-8">
<div class="flex flex-col gap-1">
<h1 class="text-text-main dark:text-white text-3xl md:text-4xl font-black leading-tight tracking-tight">Patient Flow Dashboard</h1>
<div class="flex items-center gap-2 text-text-secondary dark:text-gray-400 text-sm md:text-base font-normal">
<span>Real-time operational overview</span>
<span class="size-1 rounded-full bg-text-secondary"></span>
<span class="flex items-center gap-1 text-status-green font-medium"><span class="material-symbols-outlined text-[16px]">check_circle</span> Systems Normal</span>
</div>
</div>
<div class="flex gap-3">
<button class="flex items-center gap-2 justify-center rounded-lg h-10 px-4 bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-text-main dark:text-white text-sm font-bold shadow-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
<span class="material-symbols-outlined text-[18px]">file_download</span>
<span class="hidden sm:inline">Export Report</span>
</button>
<button class="flex items-center gap-2 justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold shadow-md hover:bg-primary-dark transition-colors">
<span class="material-symbols-outlined text-[18px]">refresh</span>
<span>Refresh Data</span>
</button>
</div>
</div>
<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
<div class="flex flex-col gap-2 rounded-xl p-6 bg-surface-light dark:bg-surface-dark shadow-sm border border-border-light dark:border-border-dark relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-[80px] text-primary">chair_alt</span>
</div>
<div class="flex justify-between items-start">
<p class="text-text-secondary dark:text-gray-400 text-sm font-medium uppercase tracking-wider">Waiting Room</p>
<span class="flex items-center text-status-green bg-green-50 dark:bg-green-900/20 px-2 py-0.5 rounded text-xs font-bold gap-1">
<span class="material-symbols-outlined text-[14px]">trending_up</span> +12%
                    </span>
</div>
<div class="flex items-baseline gap-2 mt-2">
<p class="text-text-main dark:text-white text-4xl font-bold leading-tight">42</p>
<span class="text-sm text-text-secondary dark:text-gray-500">patients</span>
</div>
<p class="text-sm text-text-secondary dark:text-gray-500 mt-auto pt-2">Avg wait time: <span class="text-text-main dark:text-gray-300 font-medium">18 mins</span></p>
</div>
<div class="flex flex-col gap-2 rounded-xl p-6 bg-surface-light dark:bg-surface-dark shadow-sm border border-border-light dark:border-border-dark relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-[80px] text-primary">bed</span>
</div>
<div class="flex justify-between items-start">
<p class="text-text-secondary dark:text-gray-400 text-sm font-medium uppercase tracking-wider">Active In-Patients</p>
<span class="flex items-center text-status-yellow bg-yellow-50 dark:bg-yellow-900/20 px-2 py-0.5 rounded text-xs font-bold gap-1">
                        95% cap
                    </span>
</div>
<div class="flex items-baseline gap-2 mt-2">
<p class="text-text-main dark:text-white text-4xl font-bold leading-tight">128</p>
<span class="text-sm text-text-secondary dark:text-gray-500">/ 150 beds</span>
</div>
<div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-1.5 mt-auto mb-1">
<div class="bg-primary h-1.5 rounded-full" style="width: 85%"></div>
</div>
</div>
<div class="flex flex-col gap-2 rounded-xl p-6 bg-surface-light dark:bg-surface-dark shadow-sm border border-border-light dark:border-border-dark relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-[80px] text-primary">output</span>
</div>
<div class="flex justify-between items-start">
<p class="text-text-secondary dark:text-gray-400 text-sm font-medium uppercase tracking-wider">Pending Discharges</p>
<span class="flex items-center text-text-secondary bg-gray-50 dark:bg-gray-800 px-2 py-0.5 rounded text-xs font-bold gap-1">
                        Today
                    </span>
</div>
<div class="flex items-baseline gap-2 mt-2">
<p class="text-text-main dark:text-white text-4xl font-bold leading-tight">15</p>
<span class="text-sm text-text-secondary dark:text-gray-500">processed</span>
</div>
<div class="flex gap-2 mt-auto pt-2">
<button class="text-primary text-sm font-bold hover:underline flex items-center gap-1">
                        View List <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</button>
</div>
</div>
</div>
<div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
<!-- Main Content: Ward Occupancy -->
<div class="xl:col-span-2 flex flex-col gap-4">
<div class="flex items-center justify-between">
<h2 class="text-text-main dark:text-white text-xl font-bold leading-tight tracking-[-0.015em]">Ward Occupancy</h2>
<button class="text-primary text-sm font-medium hover:underline">View All Wards</button>
</div>
<div class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-border-light dark:border-border-dark">
<th class="px-6 py-4 text-xs font-semibold text-text-secondary dark:text-gray-400 uppercase tracking-wider w-1/4">Ward Name</th>
<th class="px-6 py-4 text-xs font-semibold text-text-secondary dark:text-gray-400 uppercase tracking-wider w-1/3">Occupancy</th>
<th class="px-6 py-4 text-xs font-semibold text-text-secondary dark:text-gray-400 uppercase tracking-wider">Status</th>
<th class="px-6 py-4 text-xs font-semibold text-text-secondary dark:text-gray-400 uppercase tracking-wider text-right">Capacity</th>
</tr>
</thead>
<tbody class="divide-y divide-border-light dark:divide-border-dark">
<tr class="group hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
<td class="px-6 py-4">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center text-status-red">
<span class="material-symbols-outlined text-[18px]">emergency</span>
</div>
<span class="text-text-main dark:text-white font-medium">ICU South</span>
</div>
</td>
<td class="px-6 py-4">
<div class="flex flex-col gap-1.5">
<div class="flex justify-between text-xs mb-1">
<span class="font-medium text-text-main dark:text-white">95%</span>
</div>
<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
<div class="bg-status-red h-2 rounded-full" style="width: 95%;"></div>
</div>
</div>
</td>
<td class="px-6 py-4">
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-status-red dark:bg-red-900/30 dark:text-red-400">
                                            Critical
                                        </span>
</td>
<td class="px-6 py-4 text-right text-text-secondary dark:text-gray-400 font-mono text-sm">
                                        19<span class="text-gray-300 dark:text-gray-600">/</span>20
                                    </td>
</tr>
<tr class="group hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
<td class="px-6 py-4">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[18px]">ward</span>
</div>
<span class="text-text-main dark:text-white font-medium">General Ward A</span>
</div>
</td>
<td class="px-6 py-4">
<div class="flex flex-col gap-1.5">
<div class="flex justify-between text-xs mb-1">
<span class="font-medium text-text-main dark:text-white">88%</span>
</div>
<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
<div class="bg-status-yellow h-2 rounded-full" style="width: 88%;"></div>
</div>
</div>
</td>
<td class="px-6 py-4">
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-status-yellow dark:bg-yellow-900/30 dark:text-yellow-400">
                                            High
                                        </span>
</td>
<td class="px-6 py-4 text-right text-text-secondary dark:text-gray-400 font-mono text-sm">
                                        44<span class="text-gray-300 dark:text-gray-600">/</span>50
                                    </td>
</tr>
<tr class="group hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
<td class="px-6 py-4">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center text-pink-600">
<span class="material-symbols-outlined text-[18px]">child_care</span>
</div>
<span class="text-text-main dark:text-white font-medium">Maternity Ward</span>
</div>
</td>
<td class="px-6 py-4">
<div class="flex flex-col gap-1.5">
<div class="flex justify-between text-xs mb-1">
<span class="font-medium text-text-main dark:text-white">40%</span>
</div>
<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
<div class="bg-status-green h-2 rounded-full" style="width: 40%;"></div>
</div>
</div>
</td>
<td class="px-6 py-4">
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-status-green dark:bg-green-900/30 dark:text-green-400">
                                            Stable
                                        </span>
</td>
<td class="px-6 py-4 text-right text-text-secondary dark:text-gray-400 font-mono text-sm">
                                        12<span class="text-gray-300 dark:text-gray-600">/</span>30
                                    </td>
</tr>
<tr class="group hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
<td class="px-6 py-4">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600">
<span class="material-symbols-outlined text-[18px]">toys</span>
</div>
<span class="text-text-main dark:text-white font-medium">Pediatrics</span>
</div>
</td>
<td class="px-6 py-4">
<div class="flex flex-col gap-1.5">
<div class="flex justify-between text-xs mb-1">
<span class="font-medium text-text-main dark:text-white">65%</span>
</div>
<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
<div class="bg-primary h-2 rounded-full" style="width: 65%;"></div>
</div>
</div>
</td>
<td class="px-6 py-4">
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-status-green dark:bg-green-900/30 dark:text-green-400">
                                            Stable
                                        </span>
</td>
<td class="px-6 py-4 text-right text-text-secondary dark:text-gray-400 font-mono text-sm">
                                        26<span class="text-gray-300 dark:text-gray-600">/</span>40
                                    </td>
</tr>
<tr class="group hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-none">
<td class="px-6 py-4">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-600">
<span class="material-symbols-outlined text-[18px]">medical_services</span>
</div>
<span class="text-text-main dark:text-white font-medium">Surgical Wing</span>
</div>
</td>
<td class="px-6 py-4">
<div class="flex flex-col gap-1.5">
<div class="flex justify-between text-xs mb-1">
<span class="font-medium text-text-main dark:text-white">75%</span>
</div>
<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
<div class="bg-primary h-2 rounded-full" style="width: 75%;"></div>
</div>
</div>
</td>
<td class="px-6 py-4">
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-primary dark:bg-blue-900/30 dark:text-blue-400">
                                            Moderate
                                        </span>
</td>
<td class="px-6 py-4 text-right text-text-secondary dark:text-gray-400 font-mono text-sm">
                                        30<span class="text-gray-300 dark:text-gray-600">/</span>40
                                    </td>
</tr>
</tbody>
</table>
</div>
</div>
</div>
<!-- Sidebar Content -->
<div class="flex flex-col gap-8">
<!-- Congestion -->
<div class="flex flex-col gap-4">
<h2 class="text-text-main dark:text-white text-xl font-bold leading-tight tracking-[-0.015em]">Department Congestion</h2>
<div class="flex flex-col rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm overflow-hidden">
<!-- Emergency -->
<div class="flex items-center gap-4 p-4 border-b border-border-light dark:border-border-dark">
<div class="flex flex-col items-center justify-center w-12 gap-1">
<span class="material-symbols-outlined text-status-red text-[28px]">local_hospital</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<p class="font-bold text-text-main dark:text-white truncate">Emergency Room</p>
<p class="text-status-red text-xs font-bold bg-red-50 dark:bg-red-900/20 px-1.5 rounded">High Traffic</p>
</div>
<p class="text-sm text-text-secondary dark:text-gray-400">Avg Wait: <span class="text-text-main dark:text-gray-200 font-medium">45m</span></p>
</div>
</div>
<!-- Radiology -->
<div class="flex items-center gap-4 p-4 border-b border-border-light dark:border-border-dark">
<div class="flex flex-col items-center justify-center w-12 gap-1">
<span class="material-symbols-outlined text-status-yellow text-[28px]">radiology</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<p class="font-bold text-text-main dark:text-white truncate">Radiology</p>
<p class="text-status-yellow text-xs font-bold bg-yellow-50 dark:bg-yellow-900/20 px-1.5 rounded">Moderate</p>
</div>
<p class="text-sm text-text-secondary dark:text-gray-400">Next Slot: <span class="text-text-main dark:text-gray-200 font-medium">15m</span></p>
</div>
</div>
<!-- Pharmacy -->
<div class="flex items-center gap-4 p-4">
<div class="flex flex-col items-center justify-center w-12 gap-1">
<span class="material-symbols-outlined text-status-green text-[28px]">medication</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between mb-1">
<p class="font-bold text-text-main dark:text-white truncate">Pharmacy</p>
<p class="text-status-green text-xs font-bold bg-green-50 dark:bg-green-900/20 px-1.5 rounded">Low Traffic</p>
</div>
<p class="text-sm text-text-secondary dark:text-gray-400">Wait: <span class="text-text-main dark:text-gray-200 font-medium">&lt; 5m</span></p>
</div>
</div>
</div>
</div>
<!-- Recent Activity Feed -->
<div class="flex flex-col gap-4">
<div class="flex items-center justify-between">
<h2 class="text-text-main dark:text-white text-xl font-bold leading-tight tracking-[-0.015em]">Recent Activity</h2>
</div>
<div class="flex flex-col rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-sm overflow-hidden p-4 gap-4">
<div class="flex gap-3 relative pb-4 border-l-2 border-gray-100 dark:border-gray-700 pl-4 last:pb-0 last:border-0">
<div class="absolute -left-[9px] top-0 size-4 rounded-full border-2 border-surface-light dark:border-surface-dark bg-primary box-content"></div>
<div>
<p class="text-sm font-medium text-text-main dark:text-white">John Doe admitted to ICU South</p>
<p class="text-xs text-text-secondary dark:text-gray-500 mt-1">10 minutes ago</p>
</div>
</div>
<div class="flex gap-3 relative pb-4 border-l-2 border-gray-100 dark:border-gray-700 pl-4 last:pb-0 last:border-0">
<div class="absolute -left-[9px] top-0 size-4 rounded-full border-2 border-surface-light dark:border-surface-dark bg-status-green box-content"></div>
<div>
<p class="text-sm font-medium text-text-main dark:text-white">Jane Smith discharged</p>
<p class="text-xs text-text-secondary dark:text-gray-500 mt-1">24 minutes ago</p>
</div>
</div>
<div class="flex gap-3 relative pb-4 border-l-2 border-gray-100 dark:border-gray-700 pl-4 last:pb-0 last:border-0">
<div class="absolute -left-[9px] top-0 size-4 rounded-full border-2 border-surface-light dark:border-surface-dark bg-gray-400 box-content"></div>
<div>
<p class="text-sm font-medium text-text-main dark:text-white">Bed #204 cleaning completed</p>
<p class="text-xs text-text-secondary dark:text-gray-500 mt-1">1 hour ago</p>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
</body></html>